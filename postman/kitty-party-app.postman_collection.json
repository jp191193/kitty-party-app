              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group_id\": \"{{group_id}}\",\n  \"name\": \"2026 Annual Kitty\",\n  \"monthly_amount\": 5000,\n  \"start_date\": \"2026-05-01T00:00:00Z\",\n  \"end_date\": \"2027-04-30T00:00:00Z\",\n  \"notes\": \"Monthly savings cycle\",\n  \"schedule\": [\n    {\n      \"cycle_number\": 1,\n      \"cycle_month\": 5,\n      \"cycle_year\": 2026,\n      \"host_member_id\": \"{{member_id}}\",\n      \"scheduled_date\": \"2026-05-15T18:00:00Z\",\n      \"due_date\": \"2026-05-10T00:00:00Z\",\n      \"venue\": \"Anjali's House\",\n      \"notes\": \"First cycle\"\n    },\n    {\n      \"cycle_number\": 2,\n      \"cycle_month\": 6,\n      \"cycle_year\": 2026,\n      \"host_member_id\": \"{{member_id}}\",\n      \"scheduled_date\": \"2026-06-15T18:00:00Z\",\n      \"due_date\": \"2026-06-10T00:00:00Z\",\n      \"venue\": \"Community Hall\",\n      \"notes\": \"Second cycle\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/kitty-cycles/schedule", "host": ["{{base_url}}"], "path": ["api", "v1", "kitty-cycles", "schedule"] }
