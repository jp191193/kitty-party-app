{
  "info": {
    "_postman_id": "kitty-party-app-collection-v1",
    "name": "Kitty Party App",
    "description": "Full API collection for Kitty Party App. Run requests in folder order for a complete flow. Auth token is captured automatically after POST /auth/token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "http://localhost:8080", "type": "string" },
    { "key": "auth_token",    "value": "",                      "type": "string" },
    { "key": "member_id",     "value": "",                      "type": "string" },
    { "key": "group_id",      "value": "",                      "type": "string" },
    { "key": "due_id",        "value": "",                      "type": "string" },
    { "key": "payment_id",    "value": "",                      "type": "string" },
    { "key": "tracking_id",   "value": "",                      "type": "string" },
    { "key": "payout_id",     "value": "",                      "type": "string" },
    { "key": "cycle_id",      "value": "",                      "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{auth_token}}", "type": "string" }
    ]
  },
  "item": [

    {
      "name": "01 - Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        }
      ]
    },

    {
      "name": "02 - Auth",
      "item": [
        {
          "name": "Generate Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.token) {",
                  "    pm.collectionVariables.set('auth_token', json.data.token);",
                  "    console.log('Token saved:', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{member_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/token", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "token"] }
          }
        }
      ]
    },

