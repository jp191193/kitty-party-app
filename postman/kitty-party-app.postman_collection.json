      "item": [
        {
          "name": "Generate Monthly Dues",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.length > 0) {",
                  "    pm.collectionVariables.set('due_id', json.data[0].id);",
                  "    console.log('due_id saved:', json.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group_id\": \"{{group_id}}\",\n  \"host_member_id\": \"{{member_id}}\",\n  \"cycle_month\": 5,\n  \"cycle_year\": 2026,\n  \"cycle_number\": 1,\n  \"kitty_party_date\": \"2026-05-15T18:00:00Z\",\n  \"due_date\": \"2026-05-10T00:00:00Z\",\n  \"amount\": 5000\n}",
              "options": { "raw": { "language": "json" } }
